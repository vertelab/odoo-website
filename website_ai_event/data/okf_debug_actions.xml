<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- OKF-valet i debug-menyn för event.event (okf-mixin F5.10). -->
    <record id="action_okf_event_event" model="ir.actions.server">
        <field name="name">OKF</field>
        <field name="model_id" ref="event.model_event_event"/>
        <field name="binding_model_id" ref="event.model_event_event"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('base.group_no_one'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['ai.okf.mixin'].action_open_okf()</field>
    </record>
</odoo>
