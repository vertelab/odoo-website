<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- OKF-valet i debug-menyn för blog.post (okf-mixin F5.10).
         Åtgärden är generisk och bor i ai_agent_core; här deklareras
         bindningen. base.group_no_one = debug-läget är på. -->
    <record id="action_okf_blog_post" model="ir.actions.server">
        <field name="name">OKF</field>
        <field name="model_id" ref="website_blog.model_blog_post"/>
        <field name="binding_model_id" ref="website_blog.model_blog_post"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('base.group_no_one'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['ai.okf.mixin'].action_open_okf()</field>
    </record>
</odoo>
