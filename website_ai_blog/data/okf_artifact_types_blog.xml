<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Artefakttyp för website_ai_blog (okf-mixin D12).
         Bryggan äger sin typ; bridge_module gör taxonomin spårbar. -->
    <record id="artifact_type_blog_post" model="ai.artifact.type">
        <field name="name">blog_post</field>
        <field name="kind">knowledge</field>
        <field name="bridge_module">website_ai_blog</field>
        <field name="model_id" ref="website_blog.model_blog_post"/>
        <field name="okf_contract" eval="{'generated_by': 'process', 'stale_policy': 'source', 'stale_ttl_days': 0, 'retention_purpose': 'none', 'retention_days': 0}"/>
    </record>
</odoo>
