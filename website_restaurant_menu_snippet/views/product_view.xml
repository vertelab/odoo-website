<odoo>
<!-- Product product variant list view w/ toggle switch-->
    <record id="product_product_tree_view_menu_available" model="ir.ui.view">
        <field name="name">product.product.list.menu.available</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_favorite']" position="before">
                <field name="available_in_menu" 
                    string="Available in Menu" 
                    widget="boolean_toggle" 
                    readonly="0"/>
            </xpath>
            <xpath expr="//field[@name='available_in_menu']" position="before">
                <field name="sequence" widget="handle"/>
            </xpath>
        </field>
    </record>
    
