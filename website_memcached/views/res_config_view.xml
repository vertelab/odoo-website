<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_website_config_settings" model="ir.ui.view">
            <field name="name">Website settings.inherited.website_memcached</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="website.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='website_info_settings']/setting/div/div" position="after">
                    <div class="row mt8">
                        <label class="col-lg-3" string="Memcached" for="memcached_db"/>
                        <field name="memcached_db" string="Memcached" />
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
